// Learning to play from nothing: boards from the network's own games, each given a target the network is then fitted
// to — fitted value iteration, with the expectation over the next piece computed exactly.
//
// **A board's target is what it is worth if the network plays on well from it**: for each of the seven pieces that
// could come next, equally likely, the best of `points that placement scores + the network's value of the board it
// leaves`, a finished game's board worth nothing — averaged over the seven. No playouts, so no sampling noise: every
// target is the same number however often it is computed, which is what lets this learn from a network that knows
// nothing. turbostack's targets were the mean of a hundred random twenty-move playouts, and needed a network that
// already played tolerably — learned from a person's games — before they meant anything.
//
// **The lines remaining do the rest.** A board with three lines to go is worth what its next piece can score, and a
// network that has learned that is the target for boards with seven to go, and so on up: knowledge of how to finish a
// game flows back, iteration by iteration, to how to start one. So games are played to every horizon from 1 to 130
// lines, not only full ones.

import { Buf, Vec } from "core";
import { Device } from "tensor";
import { Board, PIECE_COUNT } from "./board.wac";
import { Pieces, argmax } from "./game.wac";
import { lookahead } from "./lookahead.wac";
import { ValueNet } from "./value.wac";

/** Boards and their targets, in points. */
export struct Examples {
  Vec<Board> boards;
  Vec<f32> targets;

  Examples create() { return Examples(Vec.create(), Vec.create()); }
  i32 len(const this) { return this.boards.len(); }

  void add(this, Board b, f32 target) {
    this.boards.push(b);
    this.targets.push(target);
  }

  void extend(this, Examples other) {
    for (i32 i = 0; i < other.len(); i++) { this.add(other.boards.get(i), other.targets.get(i)); }
  }

  /** As bytes: per example, the ten columns, lines cleared, lines in the game, score and tetrises as `i32`, then the target as `f32`. */
  u8[] encode(this) {
    Buf b = Buf.create();
    for (i32 i = 0; i < this.len(); i++) {
      Board x = this.boards.get(i);
      for (i32 j = 0; j < 10; j++) { b.pushU32(x.cols[j] as@ u32); }
      b.pushU32(x.linesCleared as@ u32);
      b.pushU32(x.linesMax as@ u32);
      b.pushU32(x.score as@ u32);
      b.pushU32(x.tetrises as@ u32);
      b.pushU32(f32.toBits(this.targets.get(i)));
    }
    return b.bytes();
  }

  Examples decode(u8[] bytes) {
    Examples out = Examples.create();
    i32 at = 0;
    while (at + 60 <= bytes.len()) {
      i32[] v = i32[].filled(15, 0);
      for (i32 k = 0; k < 15; k++) {
        i32 o = at + 4 * k;
        v[k] = (bytes[o] as i32) | ((bytes[o + 1] as i32) << 8) | ((bytes[o + 2] as i32) << 16) | ((bytes[o + 3] as i32) << 24);
      }
      Board b = Board.empty(v[11]);
      for (i32 j = 0; j < 10; j++) {
        for (i32 i = 0; i < 20; i++) { if ((v[j] & (1 << (19 - i))) != 0) { b.flip(i, j); } }
      }
      b.linesCleared = v[10];
      b.score = v[12];
      b.tetrises = v[13];
      out.add(b, f32.fromBits(v[14] as@ u32));
      at += 60;
    }
    return out;
  }
}

/**
 * The target of each of `boards`: the mean over the seven pieces of the best `points + value` they allow, nothing for a
 * piece with nowhere to go — `points` including `bonus` for a placement that does not top out. Every child of every
 * board is valued in one batch.
 */
export f32[] targets(Device d, ValueNet net, Board[] boards, f64 bonus) {
  Vec<Board> children = Vec.create();
  i32[] counts = i32[].filled(boards.len() * PIECE_COUNT, 0);
  for (i32 k = 0; k < boards.len(); k++) {
    for (i32 p = 0; p < PIECE_COUNT; p++) {
      Board[] cs = boards[k].choices(p);
      counts[k * PIECE_COUNT + p] = cs.len();
      for (Board c in cs) { children.push(c); }
    }
  }
  Board[] all = children.toArray();
  f32[] v = net.values(d, all);
  f32[] out = f32[].filled(boards.len(), 0.0);
  i32 at = 0;
  for (i32 k = 0; k < boards.len(); k++) {
    f64 total = 0.0;
    for (i32 p = 0; p < PIECE_COUNT; p++) {
      i32 n = counts[k * PIECE_COUNT + p];
      f64 best = 0.0;
      for (i32 c = 0; c < n; c++) {
        Board ch = all[at + c];
        f64 q = ((ch.score - boards[k].score) as f64) + (ch.finished && ch.linesCleared < ch.linesMax ? 0.0 : bonus) + (v[at + c] as f64);
        if (c == 0 || q > best) { best = q; }
      }
      total += best;
      at += n;
    }
    out[k] = (total / (PIECE_COUNT as f64)) as~ f32;
  }
  return out;
}

/** How the games that boards are drawn from are played. */
export struct Exploration {
  /** The chance a piece is put somewhere at random rather than where the network would put it. */
  f64 epsilon;
  /**
   * How many of its best placements the player values again a piece deeper (`lookahead`), 0 for none: a stronger
   * player than the network alone, whose games teach the network the value of better play than its own.
   */
  i32 look;
}

/**
 * Boards from games the network plays — each to a horizon from 1 to 130 lines, so every number of lines remaining is
 * seen — until there are `want` of them, unfinished ones only: a finished game's board is worth nothing, and the
 * network is never asked.
 */
export Board[] boardsFromPlay(Device d, ValueNet net, Pieces rng, i32 want, Exploration x) {
  Vec<Board> out = Vec.create();
  while (out.len() < want) {
    i32 lines = 1 + ((rng.uniform() * 130.0).floor() as~ i32);
    if (rng.uniform() < 0.3) { lines = 130; }
    Board b = Board.empty(lines);
    while (!b.finished && out.len() < want) {
      Board[] cs = b.choices(rng.next());
      if (cs.len() == 0) { break; }
      i32 pick = 0;
      if (rng.uniform() < x.epsilon) {
        pick = (rng.uniform() * (cs.len() as f64)).floor() as~ i32;
      } else {
        f32[] v = net.values(d, cs);
        for (i32 i = 0; i < cs.len(); i++) { v[i] = (((cs[i].score - b.score) as f64) + (v[i] as f64)) as~ f32; }
        pick = argmax(v);
      }
      b = cs[pick];
      if (!b.finished) { out.push(b); }
    }
  }
  return out.toArray();
}

/**
 * Where a training game starts: an empty board half the time; a fifth of the time a well, rows full but for one
 * shared column; and otherwise up to ten rows of random rubble at the bottom, each row short of full by one to three
 * cells chosen at random.
 *
 * **Not a lesson in how to play**, only a wider choice of where to start. From an empty board a player that knows
 * nothing takes many pieces to make a full row and usually tops out first, so line clears — the only thing that scores
 * — are almost never seen and nothing is learned. From rubble, a clear is often a piece or two away: the value of
 * filling a row is found at once, and carries over to games from an empty board, which is where play is measured. A
 * well does the same for the tetris: it shows what four lines at once pay, not how to build towards one.
 */
export Board startingBoard(Pieces rng, i32 lines) {
  Board b = Board.empty(lines);
  f64 kind = rng.uniform();
  if (kind < 0.5) { return b; }
  if (kind < 0.7) {
    // A well: up to twelve rows, each missing the same one column — an I dropped in clears four at once. A player
    // that clears lines one at a time never builds one, so it would never find out what a tetris pays.
    i32 rows = 1 + ((rng.uniform() * 12.0).floor() as~ i32);
    i32 well = (rng.uniform() * 10.0).floor() as~ i32;
    for (i32 r = 0; r < rows; r++) {
      for (i32 j = 0; j < 10; j++) { if (j != well) { b.flip(19 - r, j); } }
    }
    return b;
  }
  i32 rows = (rng.uniform() * 11.0).floor() as~ i32;
  for (i32 r = 0; r < rows; r++) {
    i32 i = 19 - r;
    bool[] gap = bool[].filled(10, false);
    i32 gaps = 1 + ((rng.uniform() * 3.0).floor() as~ i32);
    for (i32 g = 0; g < gaps; g++) { gap[(rng.uniform() * 10.0).floor() as~ i32] = true; }
    for (i32 j = 0; j < 10; j++) { if (!gap[j]) { b.flip(i, j); } }
  }
  return b;
}

/**
 * Boards from the network's own games with **λ-return** targets: each board's exact one-step target blended with what
 * the game actually went on to score from it —
 *
 *     G(t) = (1 − λ) · T(board t) + λ · (points of move t+1 + G(t+1))
 *
 * — so with λ near 1 a board learns from the whole rest of its game at once, where the one-step target alone carries
 * value back one piece an iteration and a game is three hundred and more. The exact target is still in every blend,
 * which keeps the piece sequence's luck from dominating. A random exploring move cuts the chain: what followed it is
 * not what the network would have done, so the board before it takes its one-step target alone.
 *
 * **`bonus` is a reward for every piece placed without topping out**, used only while learning and faded to nothing
 * (`tools/train.sh`). A player that knows nothing almost never clears a line, so a game's points alone give it no
 * reason to survive — topping out costs nothing it expected. Paid for surviving, it learns first to keep a low, clean
 * stack, which in a game of 130 lines means clearing them constantly; as the bonus fades, the points take over. What it
 * is measured on is the points alone.
 */
export Examples examplesFromPlay(Device d, ValueNet net, Pieces rng, i32 want, Exploration x, f64 lambda, f64 bonus) {
  Examples out = Examples.create();
  while (out.len() < want) {
    i32 lines = 1 + ((rng.uniform() * 130.0).floor() as~ i32);
    if (rng.uniform() < 0.3) { lines = 130; }
    Board b = startingBoard(rng, lines);
    Vec<Board> seq = Vec.create();
    Vec<f64> points = Vec.create();
    Vec<bool> random = Vec.create();
    while (!b.finished && out.len() + seq.len() < want) {
      Board[] cs = b.choices(rng.next());
      if (cs.len() == 0) { break; }
      i32 pick = 0;
      bool explored = rng.uniform() < x.epsilon;
      if (explored) {
        pick = (rng.uniform() * (cs.len() as f64)).floor() as~ i32;
      } else {
        f32[] pv = playerValues(d, net, b, cs);
        for (i32 i = 0; i < cs.len(); i++) {
          if (!(cs[i].finished && cs[i].linesCleared < cs[i].linesMax)) { pv[i] = ((pv[i] as f64) + bonus) as~ f32; }
        }
        if (x.look > 0) {
          // Final scores, as lookahead wants them: the same order, offset by the score so far.
          for (i32 i = 0; i < cs.len(); i++) { pv[i] = ((pv[i] as f64) + (b.score as f64)) as~ f32; }
          pv = lookahead(cs, pv, x.look, (Board[] bs) => finalScores(d, net, bs));
        }
        pick = argmax(pv);
      }
      Board next = cs[pick];
      points.push(((next.score - b.score) as f64) + (next.finished && next.linesCleared < next.linesMax ? 0.0 : bonus));
      random.push(explored);
      b = cs[pick];
      seq.push(b);
    }
    // seq[k] is the board after move k; points[k] what move k scored; random[k] whether move k was a random one.
    i32 n = seq.len();
    Board[] boards = seq.toArray();
    f32[] t = f32[].filled(n, 0.0);
    for (i32 at = 0; at < n; at += 32) {
      i32 to = at + 32 < n ? at + 32 : n;
      Board[] slice = Board[].filled(to - at, boards[0]);
      for (i32 k = at; k < to; k++) { slice[k - at] = boards[k]; }
      f32[] st = targets(d, net, slice, bonus);
      for (i32 k = at; k < to; k++) { t[k] = boards[k].finished ? 0.0 : st[k - at]; }
    }
    f64 g = 0.0;
    for (i32 k = n - 1; k >= 0; k--) {
      if (boards[k].finished) {
        g = 0.0;
      } else if (k == n - 1 || random.get(k + 1)) {
        g = t[k] as f64;
      } else {
        g = (1.0 - lambda) * (t[k] as f64) + lambda * (points.get(k + 1) + g);
      }
      if (!boards[k].finished) { out.add(boards[k], g as~ f32); }
    }
  }
  return out;
}

/**
 * Boards from the network's own games with **TD(λ)** targets: like `examplesFromPlay`, but bootstrapping from the
 * network's value of the board the game actually reached rather than from the exact seven-piece expectation —
 *
 *     G(t) = r(t+1) + (1 − λ) · V(board t+1) + λ · G(t+1)
 *
 * With λ near 1 the expectation is a small part of every target, and it is most of what computing one costs: valuing
 * every placement of every piece for every board, about 175 boards each. Without it a board costs only what playing it
 * did, so an iteration sees about seven times as many. Every move still values all of its placements — the player needs
 * them — so a random exploring move cuts the chain with the best value the piece drawn allowed, not the random one's.
 */
export Examples examplesTD(Device d, ValueNet net, Pieces rng, i32 want, Exploration x, f64 lambda, f64 bonus) {
  Examples out = Examples.create();
  while (out.len() < want) {
    i32 lines = 1 + ((rng.uniform() * 130.0).floor() as~ i32);
    if (rng.uniform() < 0.3) { lines = 130; }
    Board b = startingBoard(rng, lines);
    Vec<Board> seq = Vec.create();
    // For move k (which made seq[k]): what it scored with the bonus, the network's value of the board it made, the
    // best `score + value` its piece allowed, and whether it was a random move.
    Vec<f64> reward = Vec.create();
    Vec<f64> value = Vec.create();
    Vec<f64> best = Vec.create();
    Vec<bool> random = Vec.create();
    while (!b.finished && out.len() + seq.len() < want) {
      Board[] cs = b.choices(rng.next());
      if (cs.len() == 0) { break; }
      f32[] v = net.values(d, cs);
      f64[] q = f64[].filled(cs.len(), 0.0);
      for (i32 i = 0; i < cs.len(); i++) {
        bool toppedOut = cs[i].finished && cs[i].linesCleared < cs[i].linesMax;
        q[i] = ((cs[i].score - b.score) as f64) + (toppedOut ? 0.0 : bonus) + (v[i] as f64);
      }
      i32 g = 0;
      for (i32 i = 1; i < cs.len(); i++) { if (q[i] > q[g]) { g = i; } }
      bool explored = rng.uniform() < x.epsilon;
      i32 pick = explored ? ((rng.uniform() * (cs.len() as f64)).floor() as~ i32) : g;
      Board next = cs[pick];
      bool toppedOut = next.finished && next.linesCleared < next.linesMax;
      reward.push(((next.score - b.score) as f64) + (toppedOut ? 0.0 : bonus));
      value.push(v[pick] as f64);
      best.push(q[g]);
      random.push(explored);
      b = next;
      seq.push(b);
    }
    i32 n = seq.len();
    f64 gk = 0.0;
    for (i32 k = n - 1; k >= 0; k--) {
      Board bk = seq.get(k);
      if (bk.finished) {
        gk = 0.0;
        continue;
      }
      if (k == n - 1) {
        gk = value.get(k);
      } else if (random.get(k + 1)) {
        gk = best.get(k + 1);
      } else {
        gk = reward.get(k + 1) + (1.0 - lambda) * value.get(k + 1) + lambda * gk;
      }
      out.add(bk, gk as~ f32);
    }
  }
  return out;
}

/** The network's own player: each piece where `points now + value of the board left` is largest. */
export f32[] playerValues(Device d, ValueNet net, Board from, Board[] choices) {
  f32[] v = net.values(d, choices);
  for (i32 i = 0; i < choices.len(); i++) { v[i] = (((choices[i].score - from.score) as f64) + (v[i] as f64)) as~ f32; }
  return v;
}

/** Each board's score plus the network's value of it: the final score it expects. */
export f32[] finalScores(Device d, ValueNet net, Board[] boards) {
  f32[] v = net.values(d, boards);
  for (i32 i = 0; i < boards.len(); i++) { v[i] = (((boards[i].score as f64) + (v[i] as f64))) as~ f32; }
  return v;
}
