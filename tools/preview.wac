// The preview model: a network told the piece after the current one, as Tetris's preview shows it (`src/preview.wac`).
//
//     wac run --allow-read --allow-write tools/preview.wac init <dual.weights> <out.weights>
//     wac run --allow-read --allow-write tools/preview.wac gen <weights> <seed> <boards> <epsilon‰> <look> <out.bin>
//     wac run --allow-read tools/preview.wac eval <weights> <from> <to> <look>
//     wac run --allow-read tools/preview.wac pairs <dual.weights> <from> <to> <head>
//     wac run --allow-read --allow-write tools/preview.wac pgen <dual.weights> <seed> <boards> <epsilon‰> <out.bin>
//
// `pgen` plays games by the pair player (leaves by the first output) and writes the boards it passes through, each
// with its sampled target under those rules (`pairTarget`) for the first output, for `tools/fit.wac dual`: the
// second output is left as it is.
//
// `init` starts it from the dual network's lookahead value, the weights of the new inputs zero: it plays as that
// network does until it learns what the preview says. `gen` plays games with the preview (`look` 0 greedy, else that
// many candidates) and writes the boards it passes through, each with the next piece it was placed knowing and its
// exact target (`previewBackup`), for `tools/fit.wac preview`. `eval` plays the games of the seeds as
// `tools/evaluate.wac` does — the same pieces, each move knowing the next — printing a line a game and the time a move.

import { Sys } from "std";
import { Device, loadWeights, saveWeightsNow } from "tensor";
import { Board } from "../src/board.wac";
import { Pieces, argmax } from "../src/game.wac";
import { pairLook, pairTarget, previewBackup, previewLook } from "../src/preview.wac";
import { Examples } from "../src/selfplay.wac";
import { parseInt } from "../src/text.wac";
import { ValueConfig, ValueNet } from "../src/value.wac";

async ValueNet load(Sys sys, Device d, string path) {
  ValueNet net = ValueNet.create(d, ValueConfig.withPreview());
  auto r = loadWeights(net.params, (await sys.readFile(path)).orElse(u8[]()));
  if (r.isErr()) { trap; }
  return net;
}

export async i32 main(Sys sys) {
  string[] a = sys.args();
  Device d = Device.cpu();
  if (a[0] == "init") {
    ValueNet dual = ValueNet.create(d, ValueConfig.dual());
    auto r = loadWeights(dual.params, (await sys.readFile(a[1])).orElse(u8[]()));
    if (r.isErr()) { sys.log("preview: " + r.err()!); return 1; }
    ValueNet net = ValueNet.create(d, ValueConfig.withPreview());
    for (i32 k = 0; k < net.params.len(); k++) {
      f32[] ov = dual.params[k].valuesNow();
      f32[] nv = net.params[k].valuesNow();
      i32[] shape = net.params[k].shape;
      if (k == 6) {
        // The first dense layer: the old inputs' rows as they were, the seven new ones zero.
        for (i32 i = 0; i < nv.len(); i++) { nv[i] = i < ov.len() ? ov[i] : 0.0; }
      } else if (k == 10) {
        // The output: the lookahead value's column, the second of two.
        for (i32 i = 0; i < nv.len(); i++) { nv[i] = ov[i * 2 + 1]; }
      } else if (k == 11) {
        nv[0] = ov[1];
      } else {
        nv = ov;
      }
      net.params[k].assign(d.tensor(nv, shape));
    }
    auto w = await sys.writeFile(a[2], saveWeightsNow(net.params));
    if (w.isErr()) { sys.log("preview: " + w.err()!); return 1; }
    return 0;
  }
  bool pairs = a[0] == "pairs" || a[0] == "pgen";
  ValueNet net = pairs ? ValueNet.create(d, ValueConfig.dual()) : await load(sys, d, a[1]);
  if (pairs) {
    auto pr = loadWeights(net.params, (await sys.readFile(a[1])).orElse(u8[]()));
    if (pr.isErr()) { sys.log("preview: " + pr.err()!); return 1; }
  }
  if (a[0] == "pgen") {
    i32 seed = parseInt(a[2]);
    i32 want = parseInt(a[3]);
    f64 epsilon = (parseInt(a[4]) as f64) / 1000.0;
    Pieces rng = Pieces.seeded(seed * 7919 + 17);
    Examples ex = Examples.create();
    while (ex.len() < want) {
      i32 lines = 1 + ((rng.uniform() * 130.0).floor() as~ i32);
      if (rng.uniform() < 0.3) { lines = 130; }
      Board b = Board.empty(lines);
      i32 next = rng.next();
      while (!b.finished && ex.len() < want) {
        i32 p = next;
        next = rng.next();
        Board[] cs = b.choices(p);
        if (cs.len() == 0) { break; }
        i32 pick = rng.uniform() < epsilon ? (rng.uniform() * (cs.len() as f64)).floor() as~ i32 : argmax(pairLook(d, net, cs, next, 0));
        b = cs[pick];
        if (!b.finished) { ex.add(b, pairTarget(d, net, b, rng, 0)); }
      }
    }
    auto w = await sys.writeFile(a[5], ex.encode());
    if (w.isErr()) { sys.log("preview: " + w.err()!); return 1; }
    return 0;
  }
  if (a[0] == "gen") {
    i32 seed = parseInt(a[2]);
    i32 want = parseInt(a[3]);
    f64 epsilon = (parseInt(a[4]) as f64) / 1000.0;
    i32 look = parseInt(a[5]);
    Pieces rng = Pieces.seeded(seed * 7919 + 17);
    Examples ex = Examples.create();
    while (ex.len() < want) {
      i32 lines = 1 + ((rng.uniform() * 130.0).floor() as~ i32);
      if (rng.uniform() < 0.3) { lines = 130; }
      Board b = Board.empty(lines);
      i32 next = rng.next();
      Board[] batch = Board[]();
      while (!b.finished && ex.len() < want) {
        i32 p = next;
        next = rng.next();
        Board[] cs = b.choices(p);
        if (cs.len() == 0) { break; }
        i32 pick = 0;
        if (rng.uniform() < epsilon) {
          pick = (rng.uniform() * (cs.len() as f64)).floor() as~ i32;
        } else {
          pick = argmax(previewLook(d, net, cs, next, look));
        }
        b = cs[pick].clone();
        b.next = next;
        if (!b.finished) {
          f32[] t = previewBackup(d, net, [b]);
          ex.add(b, ((t[0] as f64) - (b.score as f64)) as~ f32);
        }
      }
    }
    auto w = await sys.writeFile(a[6], ex.encode());
    if (w.isErr()) { sys.log("preview: " + w.err()!); return 1; }
    return 0;
  }
  // eval
  i32 look = parseInt(a[4]);
  f64 sum = 0.0;
  i32 n = 0;
  i64 nanos = 0 as i64;
  i32 moves = 0;
  for (i32 seed = parseInt(a[2]); seed <= parseInt(a[3]); seed++) {
    Pieces pieces = Pieces.seeded(seed);
    Board board = Board.empty(130);
    i32 positions = 0;
    i32 next = pieces.next();
    while (true) {
      positions++;
      if (board.finished || board.maxHeight() > 15) { break; }
      i32 p = next;
      next = pieces.next();
      Board[] choices = board.choices(p);
      if (choices.len() == 0) { break; }
      i64 t0 = await sys.monotonicNanos();
      i32 pick = argmax(pairs ? pairLook(d, net, choices, next, look) : previewLook(d, net, choices, next, look));
      nanos += (await sys.monotonicNanos()) - t0;
      moves++;
      board = choices[pick];
    }
    sys.log("\{seed} \{board.score} \{positions} \{board.linesCleared} \{board.tetrises}");
    sum += board.score as f64;
    n++;
  }
  sys.log("mean \{sum / (n as f64)}, \{n} games, \{((nanos / (moves as i64)) as~ f64) / 1.0e6} ms a move");
  return 0;
}
