// Check the rules against the original: for each case `turbostack-compare`'s `vectors.ts` wrote — a position and a
// piece, with every choice the original Board found — this Board must find the same choices, in the same order, each
// with the same cells, lines, score, tetrises and whether the game ended.
//
//     wac run --allow-read tools/checkchoices.wac <choices.txt>

import { Sys } from "std";
import { Board } from "../src/board.wac";
import { parseInt, splitOn } from "../src/text.wac";

export async i32 main(Sys sys) {
  string[] args = sys.args();
  u8[] bytes = (await sys.readFile(args[0])).orElse(u8[]());
  string[] lines = splitOn(string.fromBytes(bytes), 10 as u8);
  i32 cases = 0;
  i32 choices = 0;
  i32 bad = 0;
  for (string line in lines) {
    if (line.len() == 0) { continue; }
    string[] f = splitOn(line, 32 as u8);
    Board b = Board.fromCompact(f[0], parseInt(f[2]));
    b.linesCleared = parseInt(f[1]);
    b.score = parseInt(f[3]);
    b.tetrises = parseInt(f[4]);
    i32 piece = parseInt(f[5]);
    i32 n = parseInt(f[6]);
    Board[] got = b.choices(piece);
    cases++;
    string why = "";
    if (got.len() != n) { why = "\{got.len()} choices, the original found \{n}"; }
    for (i32 k = 0; k < n && k < got.len() && why == ""; k++) {
      string[] c = splitOn(f[7 + k], 44 as u8);
      Board g = got[k];
      bool same = g.compact() == c[0] && g.linesCleared == parseInt(c[1]) && g.score == parseInt(c[2])
               && g.tetrises == parseInt(c[3]) && g.finished == (c[4] == "1");
      if (!same) { why = "choice \{k} differs"; }
      choices++;
    }
    if (why != "") {
      bad++;
      if (bad <= 5) { sys.log("case \{cases}, piece \{piece}: \{why}\n" + b.show()); }
    }
  }
  sys.log("\{cases} cases, \{choices} choices compared: \{bad} differ");
  return bad == 0 ? 0 : 1;
}
