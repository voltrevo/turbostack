// How much of one person's play the player model (`src/human.wac`) needs before its predictions mean something.
//
//     wac run --allow-read --allow-write tools/humanfit.wac <positions.txt> <q.txt> <out-dir>
//
// `positions.txt` is `tools/humandata.wac`'s, `q.txt` `tools/humanq.wac`'s (with lookahead) for every position. The
// last `TEST_GAMES` games are held out; the model is fitted to the first N moves of the rest, in the order played,
// and judged on the held-out games — never on held-out moves of games it saw, since a game's moves are alike.
//
// Prints the learning curve, the profile weights, the time a fit takes and the checks on synthetic players as
// Markdown tables, and writes `<out-dir>/curve.tsv` (one line a model and N) for the chart.

import { Sys } from "std";
import { Buf, Vec, math } from "core";
import { Board, Placement } from "../src/board.wac";
import { Pieces } from "../src/game.wac";
import { FEATURES, FEATURE_NAMES, PlayerModel, Position, Prior, best, fitPlayer, identity, mouseReachable,
         placementFeatures, sortedOrder } from "../src/human.wac";
import { parseFloat, parseInt, splitOn } from "../src/text.wac";

static i32 TEST_GAMES = 8;

/** Everything known about one recorded position. */
struct Record {
  i32 game;
  i32 move;
  i32 think;
  i32 piece;
  i32 chosen;
  /** Greedy, lookahead and turbostack-model Q of each placement, in points. */
  f64[] g;
  f64[] d;
  f64[] l;
  bool[] reachable;
  /** φ with the greedy Q (and the lookahead's, for the last feature), and with the lookahead's Q alone. */
  f64[][] phiG;
  f64[][] phiD;
  bool tuckChosen;
  bool tuckBest;
}

f64[] numbers(string[] f, i32 from) {
  f64[] out = f64[].filled(f.len() - from, 0.0);
  for (i32 i = from; i < f.len(); i++) { out[i - from] = parseFloat(f[i]); }
  return out;
}

/** The model's view of `r`, with the greedy or the lookahead Q, and synthetic choices in place of the player's. */
Position positionOf(Record r, bool lookQ, i32 chosen) {
  return Position(lookQ ? r.d : r.g, lookQ ? r.phiD : r.phiG, r.reachable, chosen);
}

/** Ranks from 1, ties sharing their mean rank. */
f64[] ranks(f64[] v) {
  i32[] o = sortedOrder(v);
  f64[] r = f64[].filled(v.len(), 0.0);
  i32 i = 0;
  while (i < o.len()) {
    i32 j = i;
    while (j + 1 < o.len() && v[o[j + 1]] == v[o[i]]) { j++; }
    f64 mean = ((i + j) as f64) / 2.0 + 1.0;
    for (i32 k = i; k <= j; k++) { r[o[k]] = mean; }
    i = j + 1;
  }
  return r;
}

f64 pearson(f64[] x, f64[] y) {
  i32 n = x.len();
  f64 mx = 0.0;
  f64 my = 0.0;
  for (i32 i = 0; i < n; i++) {
    mx += x[i];
    my += y[i];
  }
  mx = mx / (n as f64);
  my = my / (n as f64);
  f64 sxy = 0.0;
  f64 sxx = 0.0;
  f64 syy = 0.0;
  for (i32 i = 0; i < n; i++) {
    sxy += (x[i] - mx) * (y[i] - my);
    sxx += (x[i] - mx) * (x[i] - mx);
    syy += (y[i] - my) * (y[i] - my);
  }
  if (sxx == 0.0 || syy == 0.0) { return 0.0; }
  return sxy / (sxx * syy).sqrt();
}

f64 spearman(f64[] x, f64[] y) { return pearson(ranks(x), ranks(y)); }

/** How a model did on a set of positions. */
struct Score {
  /** Mean log-likelihood of the choice made, in nats, and the share of choices it ranked first and in its top three. */
  f64 ll;
  f64 top1;
  f64 top3;
  /** Spearman's correlation between the expected loss it predicts and the loss the player made, by the greedy Q. */
  f64 rho;
  /** The share of the biggest 5% of losses that fall in the 10% of positions it flags, and their mean loss. */
  f64 caught;
  f64 flaggedLoss;
}

/** The predictions `probs` judged against the choices in `ps`; `losses` is each position's loss, `lossQ` its Q. */
Score judge(Position[] ps, f64[][] probs, f64[][] lossQ, i32[] subset) {
  i32 n = subset.len();
  f64 ll = 0.0;
  f64 top1 = 0.0;
  f64 top3 = 0.0;
  f64[] expected = f64[].filled(n, 0.0);
  f64[] actual = f64[].filled(n, 0.0);
  for (i32 s = 0; s < n; s++) {
    i32 i = subset[s];
    Position p = ps[i];
    f64[] pr = probs[i];
    f64 pc = pr[p.chosen];
    ll += math.log(pc > 1.0e-300 ? pc : 1.0e-300);
    i32 above = 0;
    for (i32 k = 0; k < pr.len(); k++) { if (pr[k] > pc || (pr[k] == pc && k < p.chosen)) { above++; } }
    if (above == 0) { top1 += 1.0; }
    if (above < 3) { top3 += 1.0; }
    f64[] q = lossQ[i];
    f64 qmax = -1.0e300;
    for (i32 k = 0; k < q.len(); k++) { if (p.allowed[k] && q[k] > qmax) { qmax = q[k]; } }
    for (i32 k = 0; k < q.len(); k++) { expected[s] += pr[k] * (qmax - q[k]); }
    actual[s] = qmax - q[p.chosen];
  }
  // The biggest mistakes: the top 5% of losses; the flagged positions: the top 10% of expected losses.
  i32[] byActual = sortedOrder(actual);
  i32[] byExpected = sortedOrder(expected);
  i32 big = n / 20;
  i32 flag = n / 10;
  bool[] flagged = bool[].filled(n, false);
  f64 flaggedLoss = 0.0;
  for (i32 t = 0; t < flag; t++) {
    flagged[byExpected[n - 1 - t]] = true;
    flaggedLoss += actual[byExpected[n - 1 - t]];
  }
  f64 caught = 0.0;
  for (i32 t = 0; t < big; t++) { if (flagged[byActual[n - 1 - t]]) { caught += 1.0; } }
  f64 count = n as f64;
  return Score(ll / count, top1 / count, top3 / count, spearman(expected, actual), caught / (big as f64), flaggedLoss / (flag as f64));
}

f64[][] predict(PlayerModel m, Position[] ps) {
  f64[][] out = f64[][].defaulted(ps.len());
  for (i32 i = 0; i < ps.len(); i++) { out[i] = m.probabilities(ps[i]); }
  return out;
}

/** Every allowed placement equally likely. */
f64[][] uniform(Position[] ps) {
  f64[][] out = f64[][].defaulted(ps.len());
  for (i32 i = 0; i < ps.len(); i++) {
    f64[] pr = f64[].filled(ps[i].q.len(), 0.0);
    f64 n = 0.0;
    for (bool a in ps[i].allowed) { if (a) { n += 1.0; } }
    for (i32 k = 0; k < pr.len(); k++) { pr[k] = ps[i].allowed[k] ? 1.0 / n : 0.0; }
    out[i] = pr;
  }
  return out;
}

/** All of the probability on the engine's choice. */
f64[][] engine(Position[] ps) {
  f64[][] out = f64[][].defaulted(ps.len());
  for (i32 i = 0; i < ps.len(); i++) {
    f64[] pr = f64[].filled(ps[i].q.len(), 0.0);
    i32 b = -1;
    for (i32 k = 0; k < pr.len(); k++) { if (ps[i].allowed[k] && (b < 0 || ps[i].q[k] > ps[i].q[b])) { b = k; } }
    pr[b] = 1.0;
    out[i] = pr;
  }
  return out;
}

string f2(f64 v) { return "\{(v * 100.0).round() / 100.0}"; }
string f3(f64 v) { return "\{(v * 1000.0).round() / 1000.0}"; }
string pct(f64 v) { return "\{(v * 1000.0).round() / 10.0}%"; }

string scoreRow(string name, string n, Score s) {
  // A model that gives the choice made no chance at all — the engine's argmax, mostly — has no finite likelihood.
  bool finite = s.ll > -50.0;
  // Nor does it predict any loss but 0, so it has no positions to flag.
  if (name.indexOf("argmax") >= 0) { return "| \{name} | \{n} | −∞ | ∞ | \{pct(s.top1)} | \{pct(s.top3)} | — | — | — |"; }
  return "| \{name} | \{n} | \{finite ? f3(s.ll) : "−∞"} | \{finite ? f2(math.exp(-s.ll)) : "∞"} | \{pct(s.top1)} | \{pct(s.top3)} | \{f3(s.rho)} | \{pct(s.caught)} | \{s.flaggedLoss.round()} |";
}

static string SCORE_HEAD = "| Model | N | Log-lik/move | Perplexity | Top-1 | Top-3 | ρ(expected, actual loss) | Biggest 5% caught in top 10% | Mean loss, top 10% |\n|---|---|---|---|---|---|---|---|---|";

string tsv(string model, i32 n, Score s, string set) {
  return "\{set}\t\{model}\t\{n}\t\{s.ll}\t\{s.top1}\t\{s.top3}\t\{s.rho}\t\{s.caught}\t\{s.flaggedLoss}\n";
}

/** The indices from..to-1. */
i32[] range(i32 from, i32 to) {
  i32[] r = i32[].filled(to - from, 0);
  for (i32 i = from; i < to; i++) { r[i - from] = i; }
  return r;
}

Position[] slice(Position[] ps, i32 from, i32 to) {
  Position[] out = Position[].filled(to - from, ps[0]);
  for (i32 i = from; i < to; i++) { out[i - from] = ps[i]; }
  return out;
}

/** A placement drawn from `pr`. */
i32 draw(Pieces rng, f64[] pr) {
  f64 u = rng.uniform();
  f64 c = 0.0;
  i32 last = 0;
  for (i32 k = 0; k < pr.len(); k++) {
    if (pr[k] <= 0.0) { continue; }
    c += pr[k];
    last = k;
    if (u < c) { return k; }
  }
  return last;
}

/** The 5th to 95th percentile of `v`, less `base` rep by rep where it is given. */
string interval(f64[] v, f64[] base, bool percent) {
  f64[] d = f64[].filled(v.len(), 0.0);
  for (i32 i = 0; i < v.len(); i++) { d[i] = base.len() > 0 ? v[i] - base[i] : v[i]; }
  i32[] o = sortedOrder(d);
  f64 lo = d[o[v.len() / 20]];
  f64 hi = d[o[v.len() - 1 - v.len() / 20]];
  if (percent) { return "\{(lo * 1000.0).round() / 10.0} to \{(hi * 1000.0).round() / 10.0}"; }
  return "\{f3(lo)} to \{f3(hi)}";
}

f64 abs(f64 v) { return v < 0.0 ? -v : v; }

/** The mean and range of the first `count` of `v`. */
string spread(f64[] v, i32 count, bool percent) {
  f64 lo = 1.0e300;
  f64 hi = -1.0e300;
  f64 sum = 0.0;
  for (i32 i = 0; i < count; i++) {
    sum += v[i];
    if (v[i] < lo) { lo = v[i]; }
    if (v[i] > hi) { hi = v[i]; }
  }
  f64 mean = sum / (count as f64);
  if (percent) { return "\{pct(mean)} (\{pct(lo)}–\{pct(hi)})"; }
  return "\{f3(mean)} (\{f3(lo)}–\{f3(hi)})";
}

export async i32 main(Sys sys) {
  string[] a = sys.args();
  string outDir = a[2];
  // ---- Reading ----
  string[] posLines = splitOn(string.fromBytes((await sys.readFile(a[0])).orElse(u8[]())), 10 as u8);
  string[] qLines = splitOn(string.fromBytes((await sys.readFile(a[1])).orElse(u8[]())), 10 as u8);
  Vec<Record> recs = Vec.create();
  i32 q = 0;
  i32 hiddenChoices = 0;
  i32 hiddenChosen = 0;
  i32 hiddenBest = 0;
  for (string line in posLines) {
    if (line.len() == 0 || line.slice(0, 1) == "#") { continue; }
    string[] f = splitOn(line, 32 as u8);
    Board b = Board.fromCompact(f[10], parseInt(f[7]));
    b.linesCleared = parseInt(f[6]);
    b.score = parseInt(f[8]);
    b.tetrises = parseInt(f[9]);
    i32 piece = parseInt(f[3]);
    Placement[] ps = b.placements(piece);
    Board[] after = Board[].filled(ps.len(), b);
    for (i32 k = 0; k < ps.len(); k++) { after[k] = b.after(ps[k]); }
    f64[] g = f64[]();
    f64[] d = f64[]();
    f64[] l = f64[]();
    // This position's three lines of values, in order.
    while (q < qLines.len() && (qLines[q].len() == 0 || parseInt(splitOn(qLines[q], 32 as u8)[0]) < recs.len())) { q++; }
    while (q < qLines.len() && qLines[q].len() > 0 && parseInt(splitOn(qLines[q], 32 as u8)[0]) == recs.len()) {
      string[] qf = splitOn(qLines[q], 32 as u8);
      if (qf[1] == "g") { g = numbers(qf, 2); }
      if (qf[1] == "d") { d = numbers(qf, 2); }
      if (qf[1] == "l") { l = numbers(qf, 2); }
      q++;
    }
    if (g.len() != ps.len() || d.len() != ps.len() || l.len() != ps.len()) {
      sys.log("humanfit: position \{recs.len()} has \{ps.len()} placements but \{g.len()}/\{d.len()}/\{l.len()} values");
      return 1;
    }
    bool[] reach = mouseReachable(ps);
    i32 chosen = parseInt(f[4]);
    i32 gb = best(g);
    for (bool r in reach) { if (!r) { hiddenChoices++; } }
    if (!reach[chosen]) { hiddenChosen++; }
    if (!reach[gb]) { hiddenBest++; }
    f64[][] phiG = placementFeatures(b, ps, after, g, d);
    f64[][] phiD = placementFeatures(b, ps, after, d, f64[]());
    recs.push(Record(parseInt(f[0]), parseInt(f[1]), parseInt(f[2]), piece, chosen, g, d, l, reach, phiG, phiD,
                     phiG[chosen][9] > 0.0, phiG[gb][9] > 0.0));
  }
  i32 n = recs.len();
  i32 games = recs.get(n - 1).game;
  i32 testFrom = 0;
  while (recs.get(testFrom).game <= games - TEST_GAMES) { testFrom++; }
  sys.log("# Data\n\n\{n} positions in \{games} games; held out: games \{games - TEST_GAMES + 1}–\{games}, \{n - testFrom} positions; training: the \{testFrom} before.\n");
  sys.log("Placements the old frontend's mouse could not pick (same centre as an earlier one): \{hiddenChoices}; chosen: \{hiddenChosen}; the engine's best among them: \{hiddenBest} positions. They are left out of every model's choices.\n");

  Position[] posG = Position[].filled(n, Position(f64[](), f64[][](), bool[](), 0));
  Position[] posD = Position[].filled(n, Position(f64[](), f64[][](), bool[](), 0));
  f64[][] lossQ = f64[][].defaulted(n);
  for (i32 i = 0; i < n; i++) {
    Record r = recs.get(i);
    posG[i] = positionOf(r, false, r.chosen);
    posD[i] = positionOf(r, true, r.chosen);
    lossQ[i] = r.g;
  }

  // ---- What the player does, before any model ----
  i32 tuckChosen = 0;
  i32 tuckBest = 0;
  i32 sameAsEngine = 0;
  i32 sameAsLook = 0;
  i32 sameAsLegacy = 0;
  i32 inLegacyTop5 = 0;
  f64 lossSum = 0.0;
  Vec<f64> thinks = Vec.create();
  for (i32 i = 0; i < n; i++) {
    Record r = recs.get(i);
    if (r.tuckChosen) { tuckChosen++; }
    if (r.tuckBest) { tuckBest++; }
    if (r.chosen == best(r.g)) { sameAsEngine++; }
    if (r.chosen == best(r.d)) { sameAsLook++; }
    if (r.chosen == best(r.l)) { sameAsLegacy++; }
    i32 better = 0;
    for (i32 k = 0; k < r.l.len(); k++) { if (r.l[k] > r.l[r.chosen]) { better++; } }
    if (better < 5) { inLegacyTop5++; }
    lossSum += r.g[best(r.g)] - r.g[r.chosen];
    if (r.think > 0) { thinks.push(r.think as f64); }
  }
  f64 count = n as f64;
  f64[] th = thinks.toArray();
  i32[] tho = sortedOrder(th);
  sys.log("# What the player does\n");
  sys.log("- the self-taught engine's (greedy) choice: \{pct(sameAsEngine as f64 / count)}; the dual network's with lookahead: \{pct(sameAsLook as f64 / count)}; turbostack's model: \{pct(sameAsLegacy as f64 / count)}; in turbostack's model's top 5: \{pct(inLegacyTop5 as f64 / count)}");
  sys.log("- mean loss against the greedy engine's best: \{(lossSum / count).round()} points a move");
  sys.log("- tucks or spins chosen: \{pct(tuckChosen as f64 / count)} of moves; the engine's best is one in \{pct(tuckBest as f64 / count)}");
  if (th.len() > 0) {
    sys.log("- time a move, where known (\{th.len()} moves): median \{th[tho[th.len() / 2]].round()} ms, 10th percentile \{th[tho[th.len() / 10]].round()} ms, 90th \{th[tho[th.len() * 9 / 10]].round()} ms");
  }
  // Whether the player changed over the months: the same numbers by stretch of games.
  i32[] blockEnds = [10, 20, games - TEST_GAMES, games];
  i32 blockStart = 1;
  for (i32 be in blockEnds) {
    f64 bl = 0.0;
    i32 bm = 0;
    i32 bn = 0;
    for (i32 i = 0; i < n; i++) {
      Record r = recs.get(i);
      if (r.game < blockStart || r.game > be) { continue; }
      bn++;
      bl += r.g[best(r.g)] - r.g[r.chosen];
      if (r.chosen == best(r.g)) { bm++; }
    }
    sys.log("- games \{blockStart}–\{be} (\{bn} moves): the engine's choice \{pct(bm as f64 / (bn as f64))}, mean loss \{(bl / (bn as f64)).round()} points a move");
    blockStart = be + 1;
  }
  // Per game: how often the choice is in turbostack's model's top 5 — 100% would mean the frontend's "top 5 only".
  string perGame = "";
  for (i32 gm = 1; gm <= games; gm++) {
    i32 c = 0;
    i32 t = 0;
    for (i32 i = 0; i < n; i++) {
      Record r = recs.get(i);
      if (r.game != gm) { continue; }
      t++;
      i32 better = 0;
      for (i32 k = 0; k < r.l.len(); k++) { if (r.l[k] > r.l[r.chosen]) { better++; } }
      if (better < 5) { c++; }
    }
    if (t >= 50) { perGame += " \{gm}:\{(100 * c / t)}%"; }
  }
  sys.log("- in turbostack's model's top 5, by game (games of 50 moves or more):\{perGame}\n");

  // ---- The learning curve ----
  Prior prior = Prior(1.0, 0.01, 1.0);
  bool[] betaOnly = bool[].filled(FEATURES + 1, false);
  betaOnly[0] = true;
  bool[] all = bool[].filled(FEATURES + 1, true);
  bool[] allD = bool[].filled(FEATURES + 1, true);
  allD[FEATURES] = false;
  i32[] test = range(testFrom, n);
  i32[] sizes = [0, 25, 50, 100, 200, 500, 1000, 2000, 5000, testFrom];
  Buf curve = Buf.create();
  sys.log("# Learning curve: trained on the first N moves, judged on the held-out games\n");
  sys.log(SCORE_HEAD);
  Score su = judge(posG, uniform(posG), lossQ, test);
  sys.log(scoreRow("uniform", "—", su));
  curve.pushStr(tsv("uniform", 0, su, "human"));
  Score se = judge(posG, engine(posG), lossQ, test);
  sys.log(scoreRow("engine's argmax (greedy)", "—", se));
  curve.pushStr(tsv("argmax", 0, se, "human"));
  Score sl = judge(posD, engine(posD), lossQ, test);
  sys.log(scoreRow("engine's argmax (lookahead)", "—", sl));
  f64[] zero = PlayerModel.prior(prior).theta;
  PlayerModel[] profiles = PlayerModel[].filled(sizes.len(), PlayerModel.prior(prior));
  f64[][][] fitted = f64[][][].defaulted(sizes.len());
  f64[][][] netProbs = f64[][][].defaulted(sizes.len());
  for (i32 si = 0; si < sizes.len(); si++) {
    i32 m = sizes[si];
    PlayerModel mb = fitPlayer(posG, m, prior, betaOnly, zero);
    PlayerModel mf = fitPlayer(posG, m, prior, all, zero);
    PlayerModel md = fitPlayer(posD, m, prior, allD, zero);
    PlayerModel mdb = fitPlayer(posD, m, prior, betaOnly, zero);
    profiles[si] = mf;
    Score sb = judge(posG, predict(mb, posG), lossQ, test);
    Score sf = judge(posG, predict(mf, posG), lossQ, test);
    Score sd = judge(posD, predict(md, posD), lossQ, test);
    Score sdb = judge(posD, predict(mdb, posD), lossQ, test);
    sys.log(scoreRow("β only (β = \{f2(mb.theta[0])})", "\{m}", sb));
    sys.log(scoreRow("β + features", "\{m}", sf));
    sys.log(scoreRow("β only, lookahead Q", "\{m}", sdb));
    sys.log(scoreRow("β + features, lookahead Q", "\{m}", sd));
    curve.pushStr(tsv("beta", m, sb, "human") + tsv("features", m, sf, "human") + tsv("lookbeta", m, sdb, "human") + tsv("look", m, sd, "human"));
    // The ceiling, where `tools/humannet.wac` has written its predictions for this N.
    if (m > 0) {
      auto nf = await sys.readFile(outDir + "/net-\{m}.txt");
      if (nf.isOk()) {
        f64[][] np = f64[][].defaulted(n);
        for (string nl in splitOn(string.fromBytes(nf.ok()!), 10 as u8)) {
          if (nl.len() == 0) { continue; }
          string[] nfs = splitOn(nl, 32 as u8);
          np[parseInt(nfs[0])] = numbers(nfs, 1);
        }
        Score sn = judge(posG, np, lossQ, test);
        sys.log(scoreRow("neural ceiling (best epoch, picked on these games)", "\{m}", sn));
        curve.pushStr(tsv("neural", m, sn, "human"));
        netProbs[si] = np;
      }
    }
    fitted[si] = predict(mf, posG);
  }
  // ---- How much the penalty matters ----
  sys.log("\n# The penalty on the feature weights: β + features, first N moves, held-out games (log-likelihood / ρ / biggest 5% caught)\n");
  f64[] penalties = [0.25, 1.0, 4.0, 16.0];
  i32[] penaltySizes = [25, 50, 100, 200, 500, 2000, testFrom];
  string ph = "| Penalty weight |";
  string pr2 = "|---|";
  for (i32 m in penaltySizes) {
    ph += " N = \{m} |";
    pr2 += "---|";
  }
  sys.log(ph + "\n" + pr2);
  for (f64 pw in penalties) {
    Prior pp = Prior(1.0, 0.01, pw);
    string row = "| \{pw} |";
    for (i32 m in penaltySizes) {
      PlayerModel pm = fitPlayer(posG, m, pp, all, zero);
      Score s = judge(posG, predict(pm, posG), lossQ, test);
      row += " \{f3(s.ll)} / \{f2(s.rho)} / \{pct(s.caught)} |";
    }
    sys.log(row);
  }

  // ---- How sure: the held-out games resampled ----
  // Every model is judged on the same resample, so the differences between them are paired: much tighter than
  // each model's own interval, since a hard set of games is hard for all of them.
  sys.log("\n# Uncertainty: the 8 held-out games resampled with replacement (400 times); 5th–95th percentiles of each model's score, and of its difference from the prior (N = 0) and from the fit to all the training moves, paired on the same resample\n");
  sys.log("| Model | N | Log-lik/move | vs prior | vs all | ρ | vs prior | vs all | Biggest 5% caught | vs prior | vs all |\n|---|---|---|---|---|---|---|---|---|---|---|");
  i32[][] byGame = i32[][].defaulted(TEST_GAMES);
  for (i32 t = 0; t < TEST_GAMES; t++) {
    Vec<i32> ids = Vec.create();
    for (i32 i = testFrom; i < n; i++) { if (recs.get(i).game == games - TEST_GAMES + 1 + t) { ids.push(i); } }
    byGame[t] = ids.toArray();
  }
  Pieces brng = Pieces.seeded(99);
  i32 reps = 400;
  i32 models = sizes.len() * 2;
  // [model][rep] for each measure; model 2·si is β + features at sizes[si], 2·si + 1 the ceiling.
  f64[][] bl = f64[][].defaulted(models);
  f64[][] br = f64[][].defaulted(models);
  f64[][] bc = f64[][].defaulted(models);
  for (i32 mi = 0; mi < models; mi++) {
    bl[mi] = f64[].filled(reps, 0.0);
    br[mi] = f64[].filled(reps, 0.0);
    bc[mi] = f64[].filled(reps, 0.0);
  }
  for (i32 rep = 0; rep < reps; rep++) {
    Vec<i32> ids = Vec.create();
    for (i32 t = 0; t < TEST_GAMES; t++) {
      i32 gpick = (brng.uniform() * (TEST_GAMES as f64)).floor() as~ i32;
      for (i32 id in byGame[gpick]) { ids.push(id); }
    }
    i32[] sample = ids.toArray();
    for (i32 mi = 0; mi < models; mi++) {
      f64[][] bp = mi % 2 == 0 ? fitted[mi / 2] : netProbs[mi / 2];
      if (bp.len() == 0) { continue; }
      Score s = judge(posG, bp, lossQ, sample);
      bl[mi][rep] = s.ll;
      br[mi][rep] = s.rho;
      bc[mi][rep] = s.caught;
    }
  }
  i32 last = 2 * (sizes.len() - 1);
  for (i32 mi = 0; mi < models; mi++) {
    f64[][] bp = mi % 2 == 0 ? fitted[mi / 2] : netProbs[mi / 2];
    if (bp.len() == 0) { continue; }
    sys.log("| \{mi % 2 == 0 ? "β + features" : "neural ceiling"} | \{sizes[mi / 2]} | \{interval(bl[mi], f64[](), false)} | \{interval(bl[mi], bl[0], false)} | \{interval(bl[mi], bl[last], false)} | \{interval(br[mi], f64[](), false)} | \{interval(br[mi], br[0], false)} | \{interval(br[mi], br[last], false)} | \{interval(bc[mi], f64[](), true)} | \{interval(bc[mi], bc[0], true)} | \{interval(bc[mi], bc[last], true)} |");
  }

  // ---- Which N moves: windows starting later in the training games ----
  sys.log("\n# Which N moves: β + features trained on N moves starting at the first move of games 1, 6, 11, …, 31 (where they fit before the held-out games); mean (min–max) over the windows\n");
  sys.log("| N | Windows | Log-lik/move | Top-1 | ρ | Biggest 5% caught |\n|---|---|---|---|---|---|");
  i32[] windowSizes = [25, 50, 100, 200, 500, 1000, 2000];
  for (i32 m in windowSizes) {
    f64[] wl = f64[].filled(7, 0.0);
    f64[] wt = f64[].filled(7, 0.0);
    f64[] wr = f64[].filled(7, 0.0);
    f64[] wc = f64[].filled(7, 0.0);
    i32 windows = 0;
    for (i32 startGame = 1; startGame <= 31; startGame += 5) {
      i32 off = 0;
      while (off < testFrom && recs.get(off).game < startGame) { off++; }
      if (off + m > testFrom) { continue; }
      PlayerModel wm = fitPlayer(slice(posG, off, off + m), m, prior, all, zero);
      Score s = judge(posG, predict(wm, posG), lossQ, test);
      wl[windows] = s.ll;
      wt[windows] = s.top1;
      wr[windows] = s.rho;
      wc[windows] = s.caught;
      windows++;
    }
    sys.log("| \{m} | \{windows} | \{spread(wl, windows, false)} | \{spread(wt, windows, true)} | \{spread(wr, windows, false)} | \{spread(wc, windows, true)} |");
  }

  // ---- The time a fit takes ----
  sys.log("\n# Time a fit takes (β + features, Newton from the prior, this machine's V8 — the engine a browser runs wasm in)\n");
  sys.log("| N | From the prior | Newton steps | Warm start from the fit to N − 1 moves | Steps |\n|---|---|---|---|---|");
  i32[] timeSizes = [25, 100, 500, 1000, 2000, testFrom];
  for (i32 m in timeSizes) {
    i64 t0 = await sys.monotonicNanos();
    PlayerModel cold = PlayerModel.prior(prior);
    i32 timingReps = m <= 100 ? 20 : (m <= 1000 ? 5 : 2);
    for (i32 rep = 0; rep < timingReps; rep++) { cold = fitPlayer(posG, m, prior, all, zero); }
    f64 coldMs = (((await sys.monotonicNanos()) - t0) as~ f64) / 1.0e6 / (timingReps as f64);
    PlayerModel before = fitPlayer(posG, m - 1, prior, all, zero);
    i64 t1 = await sys.monotonicNanos();
    PlayerModel warm = PlayerModel.prior(prior);
    for (i32 rep = 0; rep < timingReps; rep++) { warm = fitPlayer(posG, m, prior, all, before.theta); }
    f64 warmMs = (((await sys.monotonicNanos()) - t1) as~ f64) / 1.0e6 / (timingReps as f64);
    sys.log("| \{m} | \{f2(coldMs)} ms | \{cold.steps} | \{f2(warmMs)} ms | \{warm.steps} |");
  }

  // ---- Synthetic players: choices drawn on the same positions from known behaviour ----
  sys.log("\n# Synthetic players: the same positions and splits, choices drawn from known behaviour\n");
  sys.log("Each fitted with β + features on its first N moves. \"truth\" is the generating model's own score on the held-out games, the best any fit could do.\n");
  sys.log("| Player | N | β (true → fitted) | Weights: true → fitted (largest other fitted weight) | Log-lik fitted / truth | ρ fitted / truth | Caught fitted / truth |\n|---|---|---|---|---|---|---|");
  string[] synthNames = ["softmax(Q/50)", "softmax(Q/200)", "softmax(Q/800)", "heuristic (no engine)", "engine + habits", "turbostack's model (argmax)"];
  for (i32 sp = 0; sp < synthNames.len(); sp++) {
    f64[] truth = f64[].filled(FEATURES + 1, 0.0);
    if (sp == 0) { truth[0] = 2.0; }
    if (sp == 1) { truth[0] = 0.5; }
    if (sp == 2) { truth[0] = 0.125; }
    if (sp == 3) {
      truth[1] = -1.5;
      truth[2] = -1.0;
      truth[4] = -1.0;
      truth[8] = 2.0;
      truth[9] = -1.0;
    }
    if (sp == 4) {
      truth[0] = 1.0;
      truth[1] = -0.5;
      truth[8] = 1.0;
      truth[10] = -1.5;
    }
    PlayerModel tm = PlayerModel(truth, 0, f64[][]());
    Pieces rng = Pieces.seeded(1000 + sp);
    Position[] sps = Position[].filled(n, posG[0]);
    f64[][] truthProbs = f64[][].defaulted(n);
    for (i32 i = 0; i < n; i++) {
      Record r = recs.get(i);
      f64[] pr = f64[]();
      if (sp == 5) {
        // turbostack's model, greedily: its best placement among those the mouse could pick.
        pr = f64[].filled(r.l.len(), 0.0);
        i32 lb = -1;
        for (i32 k = 0; k < r.l.len(); k++) { if (r.reachable[k] && (lb < 0 || r.l[k] > r.l[lb])) { lb = k; } }
        pr[lb] = 1.0;
      } else {
        pr = tm.probabilities(posG[i]);
      }
      truthProbs[i] = pr;
      sps[i] = Position(r.g, r.phiG, r.reachable, draw(rng, pr));
    }
    Score st = judge(sps, truthProbs, lossQ, test);
    i32[] synthSizes = [100, 500, 2000, testFrom];
    for (i32 m in synthSizes) {
      PlayerModel fm = fitPlayer(sps, m, prior, all, zero);
      Score sf = judge(sps, predict(fm, sps), lossQ, test);
      curve.pushStr(tsv("features", m, sf, synthNames[sp]));
      string ws = "";
      i32 other = -1;
      for (i32 j = 1; j <= FEATURES; j++) {
        if (truth[j] != 0.0) {
          ws += "\{FEATURE_NAMES[j - 1]} \{f2(truth[j])} → \{f2(fm.theta[j])}; ";
        } else if (other < 0 || abs(fm.theta[j]) > abs(fm.theta[other])) {
          other = j;
        }
      }
      if (sp == 5) {
        ws = "";
        // No truth to compare: the four largest weights say how it differs from the self-taught engine.
        f64[] mags = f64[].filled(FEATURES, 0.0);
        for (i32 j = 0; j < FEATURES; j++) { mags[j] = -abs(fm.theta[j + 1]); }
        i32[] o = sortedOrder(mags);
        for (i32 t = 0; t < 4; t++) { ws += "\{FEATURE_NAMES[o[t]]} \{f2(fm.theta[o[t] + 1])}; "; }
        other = -1;
      }
      string os = other > 0 ? "(\{FEATURE_NAMES[other - 1]} \{f2(fm.theta[other])})" : "";
      string tl = sp == 5 ? "0" : f3(st.ll);
      string tr = sp == 5 ? "—" : f3(st.rho);
      string tc = sp == 5 ? "—" : pct(st.caught);
      sys.log("| \{synthNames[sp]} | \{m} | \{sp == 5 ? "—" : f2(truth[0])} → \{f2(fm.theta[0])} | \{ws}\{os} | \{f3(sf.ll)} / \{tl} | \{f3(sf.rho)} / \{tr} | \{pct(sf.caught)} / \{tc} |");
    }
  }

  auto cw = await sys.writeFile(outDir + "/curve.tsv", curve.take());
  if (cw.isErr()) { sys.log("humanfit: " + cw.err()!); return 1; }

  // ---- The profile ----
  sys.log("\n# Profile weights (β + features, greedy Q), ± one standard error from the curvature\n");
  string head = "| Weight |";
  string rule = "|---|";
  for (i32 si = 2; si < sizes.len(); si++) {
    head += " N = \{sizes[si]} |";
    rule += "---|";
  }
  sys.log(head + "\n" + rule);
  for (i32 j = 0; j <= FEATURES; j++) {
    string row = j == 0 ? "| β (per 100 points) |" : "| \{FEATURE_NAMES[j - 1]} |";
    for (i32 si = 2; si < sizes.len(); si++) {
      PlayerModel pm = profiles[si];
      row += " \{f2(pm.theta[j])} ± \{f2(pm.covariance[j][j].sqrt())} |";
    }
    sys.log(row);
  }
  return 0;
}
