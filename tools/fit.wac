// Fit the network to the targets workers made: the next iteration's network.
//
//     wac run --allow-read --allow-write tools/fit.wac [--metal] <config> <in.weights|none> <out.weights> <epochs[:rate‱[:divisor]]> <data.bin>...
//
// The learning rate is Adam's 0.001 unless given, in ten-thousandths, after the epochs: `1:3` is one epoch at 0.0003,
// and `2:1:4` two epochs at 0.000025.
//
// A twentieth of the boards is held out and only measured, so the printed error says whether the network is learning
// the targets or memorising them. Errors are root mean square, in points.
//
// With `--metal` (and `--allow-net`) it fits on a Metal server (`src/devices.wac`); the same steps in the same order.

import { Sys } from "std";
import { Device, Tensor, loadWeights, saveWeights, tensorsOf } from "tensor";
import { Adam } from "tensor";
import { chooseDevice } from "../src/devices.wac";
import { Board } from "../src/board.wac";
import { Examples, NO_TARGET } from "../src/selfplay.wac";
import { parseInt, splitOn } from "../src/text.wac";
import { SCALE, ValueConfig, ValueNet } from "../src/value.wac";

Board[] slice(Examples ex, i32[] order, i32 from, i32 to) {
  Board[] out = Board[].filled(to - from, ex.boards.get(0));
  for (i32 i = from; i < to; i++) { out[i - from] = ex.boards.get(order[i]); }
  return out;
}

/**
 * The targets of examples `from` to `to`, `[n × heads]` in the network's units, and beside them which there are: a
 * board with no lookahead target leaves its second head untrained, not trained towards anything.
 */
f32[][] sliceTargets(Examples ex, i32[] order, i32 from, i32 to, i32 heads) {
  f32[] y = f32[].filled((to - from) * heads, 0.0);
  f32[] mask = f32[].filled((to - from) * heads, 0.0);
  for (i32 i = from; i < to; i++) {
    i32 o = (i - from) * heads;
    y[o] = ((ex.targets.get(order[i]) as f64) / SCALE) as~ f32;
    mask[o] = 1.0;
    if (heads > 1 && ex.looks.get(order[i]) != NO_TARGET) {
      y[o + 1] = ((ex.looks.get(order[i]) as f64) / SCALE) as~ f32;
      mask[o + 1] = 1.0;
    }
  }
  return [y, mask];
}

export async i32 main(Sys sys) {
  auto chosen = await chooseDevice(sys);
  if (chosen.isErr()) {
    sys.log("fit: " + chosen.err()!);
    return 1;
  }
  string[] a = chosen.ok()!.args;
  Device d = chosen.ok()!.device;
  d.seed(4242 as i64);
  ValueNet net = ValueNet.create(d, ValueConfig.named(a[0]));
  if (a[1] != "none") {
    auto r = loadWeights(net.params, (await sys.readFile(a[1])).orElse(u8[]()));
    if (r.isErr()) { sys.log("fit: " + r.err()!); return 1; }
  }
  Examples ex = Examples.create();
  for (i32 k = 4; k < a.len(); k++) { ex.extend(Examples.decode((await sys.readFile(a[k])).orElse(u8[]()))); }
  i32 n = ex.len();
  i32[] order = i32[].filled(n, 0);
  for (i32 i = 0; i < n; i++) { order[i] = i; }
  for (i32 i = n - 1; i > 0; i--) {
    i32 j = (d.random.uniform() * ((i + 1) as f64)) as~ i32;
    i32 t = order[i];
    order[i] = order[j];
    order[j] = t;
  }
  i32 held = n / 20;
  string[] er = splitOn(a[3], 58 as u8);
  i32 epochs = parseInt(er[0]);
  f64 rate = er.len() > 1 ? (parseInt(er[1]) as f64) / 10000.0 : 0.001;
  if (er.len() > 2) { rate = rate / (parseInt(er[2]) as f64); }
  Adam opt = Adam.create(rate);
  i32 heads = net.config.heads;
  i32 batch = 256;
  f64 last = 0.0;
  for (i32 e = 0; e < epochs; e++) {
    f64 total = 0.0;
    i32 steps = 0;
    for (i32 at = held; at + batch <= n; at += batch) {
      Board[] bs = slice(ex, order, at, at + batch);
      f32[][] ym = sliceTargets(ex, order, at, at + batch, heads);
      f64 count = 0.0;
      for (f32 m in ym[1]) { count += m as f64; }
      Tensor y = d.tensor(ym[0], [batch, heads]);
      Tensor mask = d.tensor(ym[1], [batch, heads]);
      Tensor loss = opt.minimize(() => net.forward(d, bs).squaredDifference(y).mul(mask).sum([], false).div(count), net.params);
      f32[] lv = await loss.values();
      total += lv[0] as f64;
      steps++;
      loss.dispose();
      y.dispose();
      mask.dispose();
    }
    last = (total / (steps as f64)).sqrt() * SCALE;
  }
  // The held-out error, by the network as it plays: a finished board counts as nothing whatever it says.
  f64 se = 0.0;
  f64 lookSe = 0.0;
  i32 looks = 0;
  for (i32 at = 0; at < held; at += batch) {
    i32 to = at + batch < held ? at + batch : held;
    f32[] v = await net.allValuesAsync(d, slice(ex, order, at, to));
    for (i32 i = at; i < to; i++) {
      f64 diff = (v[(i - at) * heads] as f64) - (ex.targets.get(order[i]) as f64);
      se += diff * diff;
      if (heads > 1 && ex.looks.get(order[i]) != NO_TARGET) {
        f64 ld = (v[(i - at) * heads + 1] as f64) - (ex.looks.get(order[i]) as f64);
        lookSe += ld * ld;
        looks++;
      }
    }
  }
  string lookText = looks > 0 ? ", lookahead held-out error \{(lookSe / (looks as f64)).sqrt().round()} (\{looks})" : "";
  sys.log("fit: \{n} boards, training error \{last.round()}, held-out error \{(se / (held as f64)).sqrt().round()}\{lookText}");
  auto w = await sys.writeFile(a[2], await saveWeights(net.params));
  if (w.isErr()) { sys.log("fit: " + w.err()!); return 1; }
  return 0;
}
