// The mean of several checkpoints of one network, weight by weight: late training checkpoints wander around a good
// point, and their average is often nearer it than any one of them.
//
//     wac run --allow-read --allow-write tools/average.wac <config> <out.weights> <in.weights>...

import { Sys } from "std";
import { Device, loadWeights, saveWeightsNow } from "tensor";
import { ValueConfig, ValueNet } from "../src/value.wac";

export async i32 main(Sys sys) {
  string[] a = sys.args();
  Device d = Device.cpu();
  ValueNet sum = ValueNet.create(d, ValueConfig.named(a[0]));
  ValueNet one = ValueNet.create(d, ValueConfig.named(a[0]));
  f32[][] totals = f32[][].defaulted(sum.params.len());
  for (i32 k = 0; k < sum.params.len(); k++) { totals[k] = f32[].filled(sum.params[k].valuesNow().len(), 0.0); }
  i32 n = a.len() - 2;
  for (i32 f = 2; f < a.len(); f++) {
    auto r = loadWeights(one.params, (await sys.readFile(a[f])).orElse(u8[]()));
    if (r.isErr()) { sys.log("average: \{a[f]}: " + r.err()!); return 1; }
    for (i32 k = 0; k < one.params.len(); k++) {
      f32[] v = one.params[k].valuesNow();
      for (i32 i = 0; i < v.len(); i++) { totals[k][i] = totals[k][i] + v[i] / (n as~ f32); }
    }
  }
  for (i32 k = 0; k < sum.params.len(); k++) { sum.params[k].assign(d.tensor(totals[k], sum.params[k].shape)); }
  auto w = await sys.writeFile(a[1], saveWeightsNow(sum.params));
  if (w.isErr()) { sys.log("average: " + w.err()!); return 1; }
  sys.log("average of \{n} checkpoints in \{a[1]}");
  return 0;
}
