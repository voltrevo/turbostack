// A file as a wac module: its bytes in base64, answered by a function of the given name — so a page can carry a
// model's weights in itself and work opened from a file, with no site to fetch them from (`web/coach.wac`).
//
//     wac run --allow-read --allow-write tools/embed.wac <file> <out.wac> <function>

import { Sys } from "std";

static string DIGITS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

string base64(u8[] b) {
  u8[] digits = DIGITS.toBytes();
  i32 n = b.len();
  u8[] out = u8[].filled(((n + 2) / 3) * 4, 61 as u8);
  i32 o = 0;
  for (i32 i = 0; i < n; i += 3) {
    i32 v = (b[i] as i32) << 16;
    if (i + 1 < n) { v = v | ((b[i + 1] as i32) << 8); }
    if (i + 2 < n) { v = v | (b[i + 2] as i32); }
    out[o] = digits[(v >> 18) & 63];
    out[o + 1] = digits[(v >> 12) & 63];
    if (i + 1 < n) { out[o + 2] = digits[(v >> 6) & 63]; }
    if (i + 2 < n) { out[o + 3] = digits[v & 63]; }
    o += 4;
  }
  return string.fromBytes(out);
}

export async i32 main(Sys sys) {
  string[] a = sys.args();
  if (a.len() != 3) {
    sys.stderr().write("usage: embed.wac <file> <out.wac> <function>\n".toBytes());
    return 2;
  }
  auto read = await sys.readFile(a[0]);
  if (read.isErr()) {
    sys.stderr().write("embed.wac: cannot read \{a[0]}\n".toBytes());
    return 1;
  }
  string text = "// Generated by tools/embed.wac from \{a[0]}: do not edit.\n\n"
              + "/** The bytes of `\{a[0]}`, in base64. */\n"
              + "export string \{a[2]}() { return \"" + base64(read.orElse(u8[]())) + "\"; }\n";
  if ((await sys.writeFile(a[1], text.toBytes())).isErr()) {
    sys.stderr().write("embed.wac: cannot write \{a[1]}\n".toBytes());
    return 1;
  }
  return 0;
}
