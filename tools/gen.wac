// One worker's share of an iteration: boards from the network's own games, each with its exact target.
//
//     wac run --allow-read --allow-write tools/gen.wac [--metal] <config> <model.weights|none> <seed> <boards> <epsilon‰> <out.bin> [λ‰ [bonus [lookahead]]]
//
// With λ, targets are λ-returns (`examplesFromPlay`); with λ negative, TD(λ) for -λ (`examplesTD`); without, the
// exact one-step targets alone.
//
// With `lookahead` k the λ-return games are played with one piece of lookahead over the k best placements.
//
// For the `dual` network the arguments after `<out.bin>` are `<lookahead-share‰> <ignored> <lookahead>`: games played with
// `lookahead` candidates, every board given its greedy target and that share of them a lookahead target as well
// (`examplesDual`, with 2 candidates) — or, with two more arguments `<playouts> <depth>`, from that many playouts of
// that many moves (`playoutTarget`).
//
// `none` is an untrained network — the start of learning from nothing.
//
// With `--metal` (and `--allow-net`), on a Metal server (`src/devices.wac`): TD(λ) or λ-returns, without lookahead, with
// `GAMES` games played at once so that each batch the GPU values is large enough to be worth sending (`generate` in
// `src/lockstep.wac`). `tools/learn.wac` does the rest on Metal in one process.

import { Sys } from "std";
import { Device, loadWeights } from "tensor";
import { Chosen, chooseDevice } from "../src/devices.wac";
import { Board } from "../src/board.wac";
import { Pieces } from "../src/game.wac";
import { Actors, Play, generate } from "../src/lockstep.wac";
import { Examples, Exploration, boardsFromPlay, examplesDual, examplesFromPlay, examplesTD, targets } from "../src/selfplay.wac";
import { parseInt } from "../src/text.wac";
import { ValueConfig, ValueNet } from "../src/value.wac";

/** How many games a worker on the GPU plays at once: about 1,600 boards a batch. */
static i32 GAMES = 64;

export async i32 main(Sys sys) {
  auto chosen = await chooseDevice(sys);
  if (chosen.isErr()) {
    sys.log("gen: " + chosen.err()!);
    return 1;
  }
  string[] a = chosen.ok()!.args;
  Device d = chosen.ok()!.device;
  bool gpu = chosen.ok()!.gpu;
  i32 seed = parseInt(a[2]);
  d.seed(seed as i64);
  ValueNet net = ValueNet.create(d, ValueConfig.named(a[0]));
  if (a[1] != "none") {
    auto r = loadWeights(net.params, (await sys.readFile(a[1])).orElse(u8[]()));
    if (r.isErr()) { sys.log("gen: " + r.err()!); return 1; }
  }
  Pieces rng = Pieces.seeded(seed * 7919 + 17);
  if (gpu) {
    if (!(a.len() > 6 && net.config.heads == 1 && !(a.len() > 8 && parseInt(a[8]) > 0))) {
      sys.log("gen: on Metal, only TD(λ) and λ-returns without lookahead run here (tools/learn.wac does the rest)");
      return 1;
    }
    i32 l = parseInt(a[6]);
    Play x = Play((parseInt(a[4]) as f64) / 1000.0, ((l < 0 ? -l : l) as f64) / 1000.0, a.len() > 7 ? parseInt(a[7]) as f64 : 0.0,
                  l < 0 ? 0.0 : 1.0, 0, 0.0, 0);
    Examples gx = await generate(d, net, rng, parseInt(a[3]), GAMES, x, Actors.create());
    auto gw = await sys.writeFile(a[5], gx.encode());
    if (gw.isErr()) { sys.log("gen: " + gw.err()!); return 1; }
    return 0;
  }
  if (net.config.heads > 1) {
    Examples dx = examplesDual(d, net, rng, parseInt(a[3]), Exploration((parseInt(a[4]) as f64) / 1000.0, a.len() > 8 ? parseInt(a[8]) : 3),
                               (parseInt(a[6]) as f64) / 1000.0, 2, a.len() > 9 ? parseInt(a[9]) : 0,
                               a.len() > 10 ? parseInt(a[10]) : 3);
    auto dw = await sys.writeFile(a[5], dx.encode());
    if (dw.isErr()) { sys.log("gen: " + dw.err()!); return 1; }
    return 0;
  }
  // λ given as negative thousandths: TD(λ), bootstrapping from the network rather than the exact expectation.
  if (a.len() > 6 && parseInt(a[6]) < 0) {
    Exploration tdx = Exploration((parseInt(a[4]) as f64) / 1000.0, a.len() > 8 ? parseInt(a[8]) : 0);
    f64 lambda = (-(parseInt(a[6])) as f64) / 1000.0;
    f64 bonus = a.len() > 7 ? parseInt(a[7]) as f64 : 0.0;
    Examples tx = examplesTD(d, net, rng, parseInt(a[3]), tdx, lambda, bonus);
    auto tw = await sys.writeFile(a[5], tx.encode());
    if (tw.isErr()) { sys.log("gen: " + tw.err()!); return 1; }
    return 0;
  }
  if (a.len() > 6) {
    Examples lx = examplesFromPlay(d, net, rng, parseInt(a[3]), Exploration((parseInt(a[4]) as f64) / 1000.0, a.len() > 8 ? parseInt(a[8]) : 0),
                                   (parseInt(a[6]) as f64) / 1000.0, a.len() > 7 ? parseInt(a[7]) as f64 : 0.0);
    auto lw = await sys.writeFile(a[5], lx.encode());
    if (lw.isErr()) { sys.log("gen: " + lw.err()!); return 1; }
    return 0;
  }
  Board[] boards = boardsFromPlay(d, net, rng, parseInt(a[3]), Exploration((parseInt(a[4]) as f64) / 1000.0, a.len() > 8 ? parseInt(a[8]) : 0));
  Examples ex = Examples.create();
  // In slices, so the children of a slice of boards are valued in one batch without holding all of them at once.
  for (i32 at = 0; at < boards.len(); at += 32) {
    i32 to = at + 32 < boards.len() ? at + 32 : boards.len();
    Board[] slice = Board[].filled(to - at, boards[0]);
    for (i32 k = at; k < to; k++) { slice[k - at] = boards[k]; }
    f32[] t = targets(d, net, slice, 0.0);
    for (i32 k = 0; k < slice.len(); k++) { ex.add(slice[k], t[k]); }
  }
  auto w = await sys.writeFile(a[5], ex.encode());
  if (w.isErr()) { sys.log("gen: " + w.err()!); return 1; }
  return 0;
}
