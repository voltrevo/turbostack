// Two players, one game: the network that taught itself and turbostack's original model, side by side on the same
// pieces, so the difference between them is their play and not their luck.
//
// Built with `tools/build.wac` and served beside `self-taught.weights` and `turbostack.weights` (`sh tools/site.sh`).
// The address's `#game-<n>` is the piece sequence, so a game can be shared and watched again; without one a random game
// is chosen, and when both players have finished another starts.

import { Page, Site, Element, ElementEvent, Listen } from "web";
import { Result } from "core";
import { Device, Tensor, loadWeights } from "tensor";
import { Board, Placement, pieceName } from "../src/board.wac";
import { Pieces } from "../src/game.wac";
import { LegacyScoreModel } from "../src/legacy.wac";
import { ValueConfig, ValueNet } from "../src/value.wac";
import { parseInt } from "../src/text.wac";

/** Pixels per cell, the last row and column of each a gutter. */
static i32 CELL = 12;

/** Each piece's colour, then the empty cell's, and the empty cell's in the five rows nobody may build into. */
static i32[] COLOURS = [
  0x3fc1d9, 0xe8c547, 0x4a7bd9, 0xe8893c, 0x5cbf5a, 0xd9534f, 0x9b6ad6,
  0x22252b, 0x2d2228,
];

struct Player {
  string name;
  bool selfTaught;
  Board board;
  /** Each cell's piece, 1 to 7, or 0 for empty: the board only knows filled and empty, and a game wants its colours. */
  u8[] colours;
  Pieces pieces;
  bool done;
  i32 pieceCount;
  /** What the player expects the game to come to, by its own model. */
  f64 expects;
  Element canvas;
  Element score;
  Element lines;
  Element tetrises;
  Element expectation;
  Element status;
}

/** The colours after `p`, a piece of kind `piece`: its cells filled, then full rows removed as the board removes them. */
u8[] coloured(u8[] before, Placement p, i32 piece, Board grid) {
  u8[] c = u8[].filled(200, 0 as u8);
  c.copyFrom(before, 0, 0, 200);
  for (i32 k = 0; k < 16; k++) {
    if ((p.grid & (1 << (15 - k))) == 0) { continue; }
    i32 i = p.row + k / 4;
    i32 j = p.col + k % 4;
    if (i >= 0 && i < 20 && j >= 0 && j < 10) { c[i * 10 + j] = (piece + 1) as~ u8; }
  }
  for (i32 i = 0; i < 20; i++) {
    bool full = true;
    for (i32 j = 0; j < 10; j++) { if (c[i * 10 + j] == 0) { full = false; } }
    if (!full) { continue; }
    for (i32 r = i; r >= 1; r--) { for (i32 j = 0; j < 10; j++) { c[r * 10 + j] = c[(r - 1) * 10 + j]; } }
    for (i32 j = 0; j < 10; j++) { c[j] = 0 as u8; }
  }
  return c;
}

u8[] render(u8[] colours) {
  i32 w = 10 * CELL;
  i32 h = 20 * CELL;
  u8[] px = u8[].filled(w * h * 4, 255 as u8);
  for (i32 y = 0; y < h; y++) {
    for (i32 x = 0; x < w; x++) {
      i32 i = y / CELL;
      i32 j = x / CELL;
      i32 v = colours[i * 10 + j] as i32;
      i32 rgb = v > 0 ? COLOURS[v - 1] : (i < 5 ? COLOURS[8] : COLOURS[7]);
      bool gutter = x % CELL == CELL - 1 || y % CELL == CELL - 1;
      // A filled cell's gutter is a shade darker than the cell, an empty one's a shade lighter: a grid either way.
      i32 r = (rgb >> 16) & 255;
      i32 g = (rgb >> 8) & 255;
      i32 b = rgb & 255;
      if (gutter) {
        r = v > 0 ? r * 3 / 4 : r + 10;
        g = v > 0 ? g * 3 / 4 : g + 10;
        b = v > 0 ? b * 3 / 4 : b + 10;
      }
      i32 at = (y * w + x) * 4;
      px[at] = r as~ u8;
      px[at + 1] = g as~ u8;
      px[at + 2] = b as~ u8;
    }
  }
  return px;
}

string thousands(i32 v) {
  string s = "\{v}";
  if (s.len() <= 3) { return s; }
  return s.slice(0, s.len() - 3) + "," + s.slice(s.len() - 3, s.len());
}

Player playerIn(Element parent, string name, string note, bool selfTaught) {
  Element card = parent.append("section");
  card.attr("class", "card");
  Element head = card.append("div");
  head.attr("class", "head");
  head.append("h2").text(name);
  head.append("span").text(note);
  Element canvas = card.append("canvas");
  Element stats = card.append("dl");
  string[] labels = ["Score", "Lines", "Tetrises", "Expects"];
  Element[] values = Element[].filled(4, stats);
  for (i32 k = 0; k < 4; k++) {
    Element row = stats.append("div");
    row.append("dt").text(labels[k]);
    values[k] = row.append("dd");
  }
  Element status = card.append("p");
  status.attr("class", "status");
  return Player(name, selfTaught, Board.empty(130), u8[].filled(200, 0 as u8), Pieces.seeded(1), false, 0, 0.0, canvas,
                values[0], values[1], values[2], values[3], status);
}

void show(Player p) {
  p.canvas.pixels(10 * CELL, 20 * CELL, render(p.colours));
  p.score.text(thousands(p.board.score));
  p.lines.text("\{p.board.linesCleared}/130");
  i32 rate = p.board.linesCleared == 0 ? 0 : (400 * p.board.tetrises) / p.board.linesCleared;
  p.tetrises.text("\{p.board.tetrises} · \{rate}%");
  p.expectation.text(p.done ? "—" : thousands(p.expects.round() as~ i32));
  if (p.done) {
    p.status.text(p.board.linesCleared >= 130 ? "Finished all 130 lines" : "Topped out after \{p.pieceCount} pieces");
  } else {
    p.status.text("\{p.pieceCount} pieces");
  }
}

void restart(Player p, i32 seed) {
  p.board = Board.empty(130);
  p.colours = u8[].filled(200, 0 as u8);
  p.pieces = Pieces.seeded(seed);
  p.done = false;
  p.pieceCount = 0;
  p.expects = 0.0;
}

export async i32 main(Page page) {
  page.title("turbostack in wac");
  Element root = page.root();
  root.append("style").text("""
      :root { color-scheme: dark; --bg: #121316; --card: #1b1d22; --rule: #2c2f36; --text: #eceae4; --muted: #9a988f; --accent: #5aa2f0; }
      @media (prefers-color-scheme: light) {
        :root { color-scheme: light; --bg: #f6f5f1; --card: #ffffff; --rule: #e2e0d9; --text: #1b1b1a; --muted: #6b6a65; --accent: #2a78d6; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif;
             -webkit-text-size-adjust: 100%; }
      main { max-width: 44rem; margin: 0 auto; padding: max(16px, env(safe-area-inset-top)) 12px calc(88px + env(safe-area-inset-bottom)); }
      h1 { font-size: 1.35rem; margin: 4px 4px 2px; letter-spacing: -0.01em; }
      .lede { color: var(--muted); margin: 0 4px 14px; font-size: .92rem; }
      .duel { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
      .card { background: var(--card); border: 1px solid var(--rule); border-radius: 14px; padding: 10px; min-width: 0; }
      .head { display: flex; flex-direction: column; margin: 0 2px 8px; }
      .head h2 { font-size: 1rem; margin: 0; }
      .head span { color: var(--muted); font-size: .78rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      canvas { display: block; width: 100%; height: auto; aspect-ratio: 1 / 2; border-radius: 6px; image-rendering: pixelated; }
      dl { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px; margin: 10px 2px 4px; }
      dl div { min-width: 0; }
      dt { color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; }
      dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 600; font-size: 1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .status { margin: 4px 2px 0; color: var(--muted); font-size: .8rem; min-height: 1.2em; }
      .tally { text-align: center; color: var(--muted); margin: 12px 0 0; font-size: .9rem; }
      .bar { position: fixed; left: 0; right: 0; bottom: 0; background: color-mix(in srgb, var(--bg) 88%, transparent);
             backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-top: 1px solid var(--rule);
             padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); }
      .bar .inner { max-width: 44rem; margin: 0 auto; display: flex; gap: 8px; align-items: center; }
      button { font: inherit; font-weight: 600; min-height: 44px; border-radius: 12px; border: 1px solid var(--rule);
               background: var(--card); color: var(--text); padding: 0 14px; touch-action: manipulation; }
      button.primary { background: var(--accent); border-color: var(--accent); color: #fff; min-width: 84px; }
      .speeds { display: flex; flex: 1; border: 1px solid var(--rule); border-radius: 12px; overflow: hidden; }
      .speeds button { flex: 1; border: 0; border-radius: 0; min-width: 0; padding: 0 4px; background: transparent; font-weight: 500; }
      .speeds button.on { background: var(--card); font-weight: 700; color: var(--accent); }
      .about { margin: 22px 4px 0; color: var(--muted); font-size: .9rem; }
      .about h3 { color: var(--text); font-size: .95rem; margin: 18px 0 4px; }
      .about p { margin: 0 0 8px; }
      .numbers { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 10px 0; }
      .numbers div { background: var(--card); border: 1px solid var(--rule); border-radius: 12px; padding: 10px; }
      .numbers b { display: block; color: var(--text); font-size: 1.3rem; font-variant-numeric: tabular-nums; }
      @media (min-width: 640px) { h1 { font-size: 1.6rem; } .duel { gap: 16px; } .card { padding: 14px; } }
      """);
  Element main = root.append("main");
  main.append("h1").text("Tetris, learned from nothing");
  main.append("p").attr("class", "lede");
  main.kidAt(1).text("A network that taught itself to play by self-play, against turbostack's original model — the same pieces for both.");
  Element duel = main.append("div");
  duel.attr("class", "duel");
  Player mine = playerIn(duel, "Self-taught", "learned by self-play", true);
  Player old = playerIn(duel, "turbostack", "learned from a person", false);
  Element tally = main.append("p");
  tally.attr("class", "tally");
  Element about = main.append("section");
  about.attr("class", "about");
  about.append("h3").text("Over 1,000 games");
  Element numbers = about.append("div");
  numbers.attr("class", "numbers");
  Element n1 = numbers.append("div");
  n1.appendText("turbostack's original model");
  n1.append("b").text("22,055");
  Element n2 = numbers.append("div");
  n2.appendText("Self-taught, so far");
  Element mineNumber = n2.append("b");
  mineNumber.text("training…");
  about.append("h3").text("How it learned");
  about.append("p").text("It started knowing nothing: random weights, no human games. It played against itself, and after every round learned to predict how many more points a board would score — at first rewarded a little just for surviving, a reward that faded to nothing as it got better, until only the real score counted.");
  about.append("p").text("turbostack's model needed to learn a person's play first before self-play could improve it. This one never saw a human game.");
  about.append("h3").text("The rules");
  about.append("p").text("130 lines a game, scored 40, 100, 300 and 1,200 for one to four lines at once. No next-piece preview. A stack taller than 15 rows ends the game. Both players are greedy: each piece goes where its model values the result most.");

  Element bar = root.append("div");
  bar.attr("class", "bar");
  Element inner = bar.append("div");
  inner.attr("class", "inner");
  Element pause = inner.append("button");
  pause.attr("class", "primary");
  pause.text("Pause");
  Element speeds = inner.append("div");
  speeds.attr("class", "speeds");
  string[] speedNames = ["Slow", "Normal", "Fast", "Max"];
  i32[] delays = [500, 150, 40, 0];
  Element[] speedButtons = Element[].filled(4, speeds);
  for (i32 k = 0; k < 4; k++) {
    speedButtons[k] = speeds.append("button");
    speedButtons[k].text(speedNames[k]);
  }
  Element again = inner.append("button");
  again.text("New");

  i32 speed = 1;
  bool paused = false;
  bool fresh = true;
  i32 seed = 0;
  for (i32 k = 0; k < 4; k++) {
    i32 which = k;
    speedButtons[k].on("click", Listen.none(), (ElementEvent e) => { speed = which; });
  }
  pause.on("click", Listen.none(), (ElementEvent e) => { paused = !paused; });
  again.on("click", Listen.none(), (ElementEvent e) => { fresh = true; seed = 0; paused = false; });
  Result<Site, string> site = await Site.of(page.sys);
  Device d = Device.cpu();
  ValueNet net = ValueNet.create(d, ValueConfig.standard());
  LegacyScoreModel legacy = LegacyScoreModel.create(d);
  bool loaded = site.isOk()
             && loadWeights(net.params, (await site.ok()!.get("self-taught.weights")).orElse(u8[]())).isOk()
             && loadWeights(legacy.params, (await site.ok()!.get("turbostack.weights")).orElse(u8[]())).isOk();
  if (!loaded) {
    tally.text("The models' weights are not on this site, so there is nothing to watch.");
    return 1;
  }
  // The address is known once the page has heard from its host, which it has by now: read it here, not at the start.
  string where = page.location();
  if (where.len() > 5 && where.slice(0, 5) == "game-") { seed = parseInt(where.slice(5, where.len())); }
  Result<u8[], string> best = await site.ok()!.get("self-taught.txt");
  if (best.isOk()) { mineNumber.text(string.fromBytes(best.ok()!)); }

  i32 mineWins = 0;
  i32 oldWins = 0;
  i32 ties = 0;
  f64 finishedAt = 0.0;
  Player[] players = [mine, old];
  while (true) {
    if (fresh) {
      fresh = false;
      if (seed == 0) { seed = 1 + ((page.now() * 7919.0) % 999983.0).floor() as~ i32; }
      page.go("game-\{seed}", false);
      for (Player p in players) { restart(p, seed); show(p); }
      seed = 0;
      finishedAt = 0.0;
    }
    for (i32 k = 0; k < 4; k++) { speedButtons[k].attr("class", k == speed ? "on" : ""); }
    pause.text(paused ? "Play" : "Pause");
    bool allDone = mine.done && old.done;
    if (paused || allDone) {
      // Both finished: the result stands for a few seconds, then another game starts by itself.
      if (allDone && !paused && finishedAt > 0.0 && page.now() - finishedAt > 4000.0) { fresh = true; }
      await page.nextFrame();
      continue;
    }
    for (Player p in players) {
      if (p.done) { continue; }
      i32 piece = p.pieces.next();
      Placement[] ps = p.board.placements(piece);
      if (ps.len() == 0 || p.board.finished || p.board.maxHeight() > 15) {
        p.done = true;
        show(p);
        continue;
      }
      Board[] cs = Board[].filled(ps.len(), p.board);
      for (i32 k = 0; k < ps.len(); k++) { cs[k] = p.board.after(ps[k]); }
      f32[] v = f32[]();
      if (p.selfTaught) {
        v = net.values(d, cs);
        for (i32 k = 0; k < cs.len(); k++) { v[k] = ((cs[k].score as f64) + (v[k] as f64)) as~ f32; }
      } else {
        Tensor t = d.tidy(() => legacy.predict(d, cs));
        v = t.valuesNow();
        t.dispose();
      }
      i32 pick = 0;
      for (i32 k = 1; k < v.len(); k++) { if (v[k] > v[pick]) { pick = k; } }
      p.colours = coloured(p.colours, ps[pick], piece, cs[pick]);
      p.board = cs[pick];
      p.pieceCount++;
      p.expects = v[pick] as f64;
      if (p.board.finished) { p.done = true; }
      show(p);
    }
    if (mine.done && old.done) {
      finishedAt = page.now();
      if (mine.board.score > old.board.score) { mineWins++; }
      else if (old.board.score > mine.board.score) { oldWins++; }
      else { ties++; }
      tally.text("Games watched — self-taught \{mineWins}, turbostack \{oldWins}" + (ties > 0 ? ", tied \{ties}" : ""));
    }
    if (delays[speed] > 0) { await page.sleep(delays[speed]); } else { await page.nextFrame(); }
  }
}
