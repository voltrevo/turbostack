{
  // What another project gets from `import { Board, Game } from "turbostack"`.
  exports: './src/lib.wac',
  imports: {
    // Tensors, layers, gradients and checkpoints.
    tensor: { git: 'https://github.com/voltrevo/wac.git', ref: 'c0f50a1f8d6baa6af641b0022f25fc1c2f4eab47', subdir: './projects/tensor' },
    // gzip and JSON, for reading recorded human games (`tools/human*.wac`).
    wac: { git: 'https://github.com/voltrevo/wac.git', ref: '3e430f338603ae64fa2107fa3f1e43af876eb821' },
    // Only the pages site (`web/play.wac`) and its builder use these.
    web: { git: 'https://github.com/voltrevo/wac.git', ref: '472f2846eb0ee0c2742b4872df03fd97842a044e', subdir: './projects/web' },
    webbuild: { git: 'https://github.com/voltrevo/wac.git', ref: '472f2846eb0ee0c2742b4872df03fd97842a044e', subdir: './projects/web/tools' },
  },
}
