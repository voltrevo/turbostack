# /etc/coach/coach.env: what the coach's server is told besides its port and data directory (deploy/coach.service).
# The site's own address: a POST from any other origin is refused.
ORIGIN=https://COACH_DOMAIN
# How long a game is kept, from when it started, and how much is kept in all and for one player.
RETENTION_DAYS=365
MAX_TOTAL_MB=10240
MAX_PLAYER_MB=20
